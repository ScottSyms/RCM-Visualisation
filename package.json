{
  "name": "rcm-mission-visualisation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Cinematic interactive visualisation of the RADARSAT Constellation Mission (RCM)",
  "scripts": {
    "dev": "npm run sync:cesium && vite",
    "build": "npm run sync:cesium && vite build",
    "preview": "vite preview",
    "data": "tsx scripts/data/run.mjs",
    "assets": "node scripts/assets/fetch-assets.mjs",
    "sync:cesium": "node scripts/sync-cesium.mjs",
    "test": "vitest run",
    "test:live": "vitest run tests/live",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "cesium": "^1.144.0",
    "satellite.js": "^7.1.0",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@browsermcp/mcp": "^0.1.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "svelte-check": "^4.3.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
